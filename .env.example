# Copy to .env.local. Never commit real credentials.
NODE_ENV=development
PORT=4000
API_HOST=127.0.0.1
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Optional separate provider database when application data is local.
NEON_AUTH_DATABASE_URL=
VITE_NEON_AUTH_URL=
VITE_API_URL=http://localhost:4000
BUSINESS_ID=northstar-supply
ALLOW_DEVELOPMENT_SEED=true
# Generated by npm run setup:local for the local development services.
POSTGRES_PASSWORD=
TEST_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:56379
# Optional until Stripe test credentials are available; set all three together.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# CHECKOUT_RETURN_ORIGIN=http://127.0.0.1:5173
WORKER_HOST=127.0.0.1
WORKER_PORT=4010
