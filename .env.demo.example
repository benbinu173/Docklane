# Copy to .env.demo.local. Supply the demo branch's credentials, never development's.
NODE_ENV=production
ALLOW_DEVELOPMENT_SEED=false
BUSINESS_ID=northstar-supply
API_HOST=0.0.0.0
TRUST_PROXY_HOPS=1
PORT=4000
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Direct host of the isolated demo branch, without protocol/path/credentials.
DEMO_DATABASE_HOST=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
VITE_NEON_AUTH_URL=
VITE_API_URL=
WEB_ORIGINS=
CHECKOUT_RETURN_ORIGIN=
STRIPE_SECRET_KEY=
# Use the deployed endpoint's signing secret; Stripe CLI's secret is different.
STRIPE_WEBHOOK_SECRET=
REDIS_URL=
WORKER_HOST=127.0.0.1
WORKER_PORT=4010
# Enable only for a reviewed, empty demo database bootstrap; disable afterwards.
ALLOW_DEMO_BOOTSTRAP=false
DEMO_ACCOUNTS_FILE=.local/release/accounts.json
